# Copy this file to ".env" and fill in real values.
# ".env" is gitignored and will NEVER be committed - that is the whole point.

# Generate a fresh one: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-value

DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost

CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Gmail SMTP - use a Gmail "App Password", NOT your normal password.
# Create one at: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your_conference_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password

# Optional - only needed if you wire up WhatsApp broadcast via green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
